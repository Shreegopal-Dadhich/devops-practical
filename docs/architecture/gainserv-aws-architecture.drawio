ll><mxCell id="c64" value="4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#C925D1;strokeWidth=2;dashed=0;fontSize=11;fontStyle=1;fontColor=#C925D1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c35" target="c47"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="890" y="425"/><mxPoint x="1170" y="425"/><mxPoint x="1170" y="446"/></Array></mxGeometry></mxCell><mxCell id="c65" value="4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#C925D1;strokeWidth=2;dashed=1;fontSize=11;fontStyle=1;fontColor=#C925D1;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c35" target="c32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c66" value="5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#ED7100;strokeWidth=2;dashed=1;fontSize=11;fontStyle=1;fontColor=#ED7100;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c45" target="c40"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1150" y="186"/><mxPoint x="1150" y="380"/><mxPoint x="523" y="380"/></Array></mxGeometry></mxCell><mxCell id="c67" value="6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#ED7100;strokeWidth=2;dashed=0;fontSize=11;fontStyle=1;fontColor=#ED7100;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c36" target="c43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c68" value="7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=2;dashed=0;fontSize=11;fontStyle=1;fontColor=#545B64;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c52"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="200" y="788"/><mxPoint x="200" y="962"/></Array></mxGeometry></mxCell><mxCell id="c69" value="lock" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#545B64;strokeWidth=2;dashed=0;fontSize=11;fontStyle=1;fontColor=#545B64;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c52" target="c53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c70" value="8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#16A34A;strokeWidth=2;dashed=0;fontSize=11;fontStyle=1;fontColor=#16A34A;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c46" target="c55"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c71" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#DD344C;strokeWidth=2;dashed=1;fontSize=11;fontStyle=1;fontColor=#DD344C;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c49" target="c32"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1140" y="706"/><mxPoint x="1140" y="630"/><mxPoint x="712" y="630"/></Array></mxGeometry></mxCell><mxCell id="c72" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#8C4FFF;strokeWidth=2;dashed=1;fontSize=11;fontStyle=1;fontColor=#8C4FFF;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="c24" target="c21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="846" y="205"/><mxPoint x="260" y="205"/><mxPoint x="260" y="237"/></Array></mxGeometry></mxCell><mxCell id="c73" value="&lt;b&gt;Flows&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#2563EB&#x27;&gt;&lt;b&gt;1&lt;/b&gt;&lt;/font&gt;  User → ALB → pods (NetworkPolicy allows only the ALB subnets)&lt;br&gt;&lt;font color=&#x27;#DD344C&#x27;&gt;&lt;b&gt;2&lt;/b&gt;&lt;/font&gt;  Pod gets temporary AWS credentials via IRSA - no access keys&lt;br&gt;&lt;font color=&#x27;#16A34A&#x27;&gt;&lt;b&gt;3&lt;/b&gt;&lt;/font&gt;  Pod reads its own S3 bucket through the free gateway endpoint&lt;br&gt;&lt;font color=&#x27;#C925D1&#x27;&gt;&lt;b&gt;4&lt;/b&gt;&lt;/font&gt;  External Secrets reads SSM, creates the k8s Secret (KMS-encrypted)&lt;br&gt;&lt;font color=&#x27;#ED7100&#x27;&gt;&lt;b&gt;5&lt;/b&gt;&lt;/font&gt;  Nodes pull the image from ECR (layers via S3 endpoint, not NAT)&lt;br&gt;&lt;font color=&#x27;#ED7100&#x27;&gt;&lt;b&gt;6&lt;/b&gt;&lt;/font&gt;  HPA adds pods → Pending → Cluster Autoscaler adds Spot nodes&lt;br&gt;&lt;font color=&#x27;#545B64&#x27;&gt;&lt;b&gt;7&lt;/b&gt;&lt;/font&gt;  Terraform state in S3, locked by DynamoDB&lt;br&gt;&lt;font color=&#x27;#16A34A&#x27;&gt;&lt;b&gt;8&lt;/b&gt;&lt;/font&gt;  App data replicated to Singapore (DR)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#232F3E;fillColor=#FFFFFF;strokeColor=#AAB7B8;rounded=1;arcSize=4;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1450" y="360" width="310" height="260" as="geometry"/></mxCell><mxCell id="c74" value="&lt;b&gt;Security&lt;/b&gt;&lt;br&gt;• non-root, no privilege escalation, read-only FS&lt;br&gt;• default-deny NetworkPolicy per namespace&lt;br&gt;• no secrets in image / git / Terraform state&lt;br&gt;• IMDS hop limit 1: pods can&#x27;t use the node role&lt;br&gt;&lt;br&gt;&lt;b&gt;Cost&lt;/b&gt;&lt;br&gt;• Spot for burst, On-Demand + Savings Plan for baseline&lt;br&gt;• S3 gateway endpoint keeps image pulls off NAT" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#232F3E;fillColor=#FFFFFF;strokeColor=#AAB7B8;rounded=1;arcSize=4;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1450" y="640" width="310" height="230" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>